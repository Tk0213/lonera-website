{
  "name": "lonera-website",
  "version": "1.0.0",
  "private": true,
  "description": "Lonera — Calgary's marketplace for newcomer communities",
  "scripts": {
    "start": "npm run start --workspace @lonera/server",
    "web": "npm run dev --workspace @lonera/web",
    "web:build": "npm run build --workspace @lonera/web",
    "prototype": "python3 scripts/wrap-prototype.py",
    "design": "python3 scripts/build-design-system.py --out design-system",
    "test": "node --test \"tests/**/*.test.js\"",
    "audit": "npm audit --omit=dev"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "workspaces": [
    "packages/core",
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12"
  }
}
